{
  "expo": {
    "name": "Otium Uni Hub",
    "slug": "otium-uni-hub",
    "scheme": "otium",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F1D",
    "splash": {
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otium.unihub"
    },
    "android": {
      "package": "com.otium.unihub",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1D"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "d96adb32-f6ac-446f-81ee-bef9df9d6ec3"
      }
    }
  }
}
