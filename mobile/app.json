{
  "expo": {
    "name": "Otium Uni Hub",
    "slug": "otium-uni-hub",
    "scheme": "otium",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F1D",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otium.unihub"
    },
    "android": {
      "package": "com.otium.unihub",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1D"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0A0F1D",
      "translucent": false
    },
    "androidNavigationBar": {
      "visible": "visible",
      "barStyle": "light-content",
      "backgroundColor": "#0A0F1D"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d96adb32-f6ac-446f-81ee-bef9df9d6ec3"
      }
    }
  }
}
