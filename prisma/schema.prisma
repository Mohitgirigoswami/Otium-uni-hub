generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PRINT_MANAGER
  CAMPUS_MODERATOR
  SUPER_ADMIN
}

enum TaskCategory {
  ASSIGNMENT
  PROJECT
  RESEARCH
  PRESENTATION
  CODING
  DESIGN
  TUTORING
  OTHER
}

enum TaskStatus {
  OPEN
  CLAIMED
  PENDING_ADVANCE
  ADVANCE_VERIFIED
  WORK_WITH_ADMIN
  PENDING_FINAL
  FINAL_VERIFIED
  COMPLETED
  BUYER_GHOSTED
  CANCELLED
}

enum MarketplaceCategory {
  BOOKS_NOTES
  ELECTRONICS
  FURNITURE
  CYCLES_TRANSPORT
  HOSTEL_ESSENTIALS
  CLOTHING
  OTHER
}

enum ItemCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MarketplaceStatus {
  AVAILABLE
  SOLD
}

enum PrintType {
  BW_SINGLE
  BW_DOUBLE
  COLOR_SINGLE
  COLOR_DOUBLE
}

enum PrintStatus {
  SUBMITTED
  PRINTING
  OUT_FOR_DELIVERY
  READY
  DELIVERED
  COMPLETED
}

enum LostAndFoundStatus {
  UNCLAIMED
  CLAIMED
}

enum RideShareStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum TicketType {
  FEEDBACK
  BUG
  REPORT_USER
}

enum TicketStatus {
  OPEN
  RESOLVED
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  bio                String?
  phone              String?
  department         String?
  year               Int?
  role               Role               @default(STUDENT)
  collegeId          String?
  college            College?           @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  freelancerCooldown DateTime?
  isBanned           Boolean            @default(false)
  banReason          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts           Account[]
  sessions           Session[]
  incognitoProfile   IncognitoProfile?
  postedTasks        TaskGig[]          @relation("TaskPoster")
  assignedTasks      TaskGig[]          @relation("TaskAssignee")
  marketplaceItems   MarketplaceItem[]
  subjects           Subject[]
  printOrders        PrintOrder[]
  lostAndFoundItems  LostAndFoundItem[]
  hostedRides        RideShare[]        @relation("RideHost")
  bookedRides        RideShareBooking[]
  cgpaSemesters      SemesterCGPA[]
  conversationsAsP1  Conversation[]     @relation("ParticipantOne")
  conversationsAsP2  Conversation[]     @relation("ParticipantTwo")
  sentMessages       Message[]
  tickets            Ticket[]
  auditLogs          AuditLog[]         @relation("AdminAuditLogs")
  postLikes          PostLike[]
}

model College {
  id                String             @id @default(cuid())
  name              String             @unique
  city              String
  createdAt         DateTime           @default(now())

  users             User[]
  marketplaceItems  MarketplaceItem[]
  postedTasks       TaskGig[]
  lostAndFoundItems LostAndFoundItem[]
  incognitoPosts    IncognitoPost[]
  campusServices    CampusService[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlatformSetting {
  id        String   @id @default("global_config")
  upiId     String   @default("admin@upi")
  updatedAt DateTime @updatedAt
}

model PrintSetting {
  id              String   @id @default("default")
  singleSidedRate Int      @default(250) // price per page in Paise (e.g., 250 for ₹2.50)
  doubleSidedRate Int      @default(200) // price per page in Paise (e.g., 200 for ₹2.00)
  updatedAt       DateTime @updatedAt
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  type      TicketType   @default(FEEDBACK)
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Conversation {
  id                    String            @id @default(cuid())
  participantOneId      String?
  participantOne        User?             @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwoId      String?
  participantTwo        User?             @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  anonParticipantOneId  String?           // Cryptographic blind ID hash
  anonParticipantTwoId  String?           // Cryptographic blind ID hash
  incognitoProfileOneId String?
  incognitoProfileOne   IncognitoProfile? @relation("AnonParticipantOne", fields: [incognitoProfileOneId], references: [id], onDelete: Cascade)
  incognitoProfileTwoId String?
  incognitoProfileTwo   IncognitoProfile? @relation("AnonParticipantTwo", fields: [incognitoProfileTwoId], references: [id], onDelete: Cascade)
  isAnonymousChat       Boolean           @default(false)
  messages              Message[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([anonParticipantOneId])
  @@index([anonParticipantTwoId])
}

model Message {
  id                 String            @id @default(cuid())
  conversationId     String
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String?
  sender             User?             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  anonSenderId       String?           // Cryptographic blind ID hash
  incognitoProfileId String?
  incognitoProfile   IncognitoProfile? @relation(fields: [incognitoProfileId], references: [id], onDelete: Cascade)
  content            String
  createdAt          DateTime          @default(now())

  @@index([conversationId])
  @@index([anonSenderId])
}

model IncognitoProfile {
  id                    String             @id @default(cuid())
  handle                String             @unique
  avatarUrl             String
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                 IncognitoPost[]
  comments              IncognitoComment[]
  conversationsAsAnonP1 Conversation[]     @relation("AnonParticipantOne")
  conversationsAsAnonP2 Conversation[]     @relation("AnonParticipantTwo")
  messages              Message[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model IncognitoPost {
  id         String             @id @default(cuid())
  content    String
  mediaUrl   String?
  mediaUrls  String[]           @default([])
  feedType   String             @default("GENERAL")
  profileId  String
  profile    IncognitoProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  collegeId  String?
  college    College?           @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  likesCount Int                @default(0)
  likes      PostLike[]
  comments   IncognitoComment[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model MarketplaceItem {
  id          String              @id @default(cuid())
  title       String
  description String
  price       Int                 // Strictly stored in Paise
  category    MarketplaceCategory
  condition   ItemCondition
  status      MarketplaceStatus   @default(AVAILABLE)
  images      String[]
  sellerId    String
  seller      User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  collegeId   String?
  college     College?            @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TaskGig {
  id                 String       @id @default(cuid())
  title              String
  description        String
  fileUrl            String?
  budget             Int          // Strictly stored in Paise
  category           TaskCategory
  status             TaskStatus   @default(OPEN)
  isAnonymousWriter  Boolean      @default(false)
  advanceUtr         String?
  finalUtr           String?
  payoutUtr          String?
  deadline           DateTime?
  posterId           String
  poster             User         @relation("TaskPoster", fields: [posterId], references: [id], onDelete: Cascade)
  assignedToId       String?
  assignedTo         User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  collegeId          String?
  college            College?     @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Subject {
  id              String             @id @default(cuid())
  name            String
  code            String?
  totalClasses    Int                @default(0)
  attendedClasses Int                @default(0)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  records         AttendanceRecord[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // PRESENT, ABSENT, CANCELLED
  createdAt DateTime @default(now())
}

model PrintOrder {
  id               String      @id @default(cuid())
  fileName         String
  fileUrl          String?
  pageCount        Int
  printType        PrintType
  deliveryLocation String
  expectedDelivery DateTime
  totalCost        Int         // Strictly stored in Paise
  status           PrintStatus @default(SUBMITTED)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model LostAndFoundItem {
  id            String             @id @default(cuid())
  finderId      String
  finder        User               @relation(fields: [finderId], references: [id], onDelete: Cascade)
  title         String
  description   String
  locationFound String
  dateFound     DateTime
  imageUrl      String
  category      String?            @default("OTHER")
  status        LostAndFoundStatus @default(UNCLAIMED)
  claimNotes    String?
  claimedById   String?
  collegeId     String?
  college       College?           @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model RideShare {
  id                String             @id @default(cuid())
  hostId            String
  host              User               @relation("RideHost", fields: [hostId], references: [id], onDelete: Cascade)
  origin            String             @default("Campus Main Gate")
  destination       String
  departureTime     DateTime
  availableSeats    Int
  totalSeats        Int                @default(4)
  splitCostEstimate Int                // Strictly stored in Paise
  cabProvider       String?            @default("Uber/Ola")
  status            RideShareStatus    @default(OPEN)
  bookings          RideShareBooking[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model RideShareBooking {
  id          String    @id @default(cuid())
  rideId      String
  ride        RideShare @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   User      @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  seatsBooked Int       @default(1)
  createdAt   DateTime  @default(now())
}

model SemesterCGPA {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester     Int
  gpa          Float
  totalCredits Float
  courses      String   // JSON encoded courses list [{name, credits, grade, gradePoint}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model PostLike {
  id        String        @id @default(cuid())
  postId    String
  post      IncognitoPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model IncognitoComment {
  id         String           @id @default(cuid())
  content    String
  postId     String
  post       IncognitoPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId  String
  profile    IncognitoProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([postId])
  @@index([profileId])
}

model CampusService {
  id                 String   @id @default(cuid())
  campusId           String   // Foreign key to the existing College/Campus model
  serviceKey         String   // e.g., "PRINT_STATION", "INCOGNITO_WALL", "MARKETPLACE", "CAB_SPLIT"
  serviceName        String   // Display name: e.g., "Hostel Cloud Print Station"
  isEnabled          Boolean  @default(true)
  maintenanceMessage String?  @default("This service is temporarily paused for your campus.")
  updatedAt          DateTime @updatedAt

  campus             College  @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([campusId, serviceKey])
  @@index([campusId])
}


